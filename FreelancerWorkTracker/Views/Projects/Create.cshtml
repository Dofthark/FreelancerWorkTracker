@model FreelancerWorkTracker.Models.Project

@{
    ViewData["Title"] = "Yeni Proje";
}

<div class="form-page">

    <div class="form-page-header">

        <div>
            <p class="page-eyebrow">PROJE YÖNETİMİ</p>
            <h1>Yeni Proje</h1>
            <p>Yeni bir proje oluştur ve müşterinle ilişkilendir.</p>
        </div>

        <a asp-action="Index"
           class="back-button">
            ← Projelere Dön
        </a>

    </div>


    <div class="form-card">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>


            <div class="form-section-title">

                <span>Proje Bilgileri</span>

                <small>
                    Projenin temel bilgilerini ve teslim sürecini belirle.
                </small>

            </div>


            <div class="form-grid">


                <div class="form-group full-width">

                    <label asp-for="Name">
                        Proje Adı
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Örn: E-Ticaret Web Sitesi" />

                    <span asp-validation-for="Name"
                          class="text-danger"></span>

                </div>


                <div class="form-group full-width">

                    <label asp-for="Description">
                        Proje Açıklaması
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Proje hakkında kısa bir açıklama..."></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger"></span>

                </div>


                <div class="form-group">

                    <label asp-for="CustomerId">
                        Müşteri
                    </label>

                    <select asp-for="CustomerId"
                            asp-items="ViewBag.CustomerId"
                            class="form-select">

                        <option value="">
                            Müşteri seçiniz
                        </option>

                    </select>

                    <span asp-validation-for="CustomerId"
                          class="text-danger"></span>

                </div>


                <div class="form-group">

                    <label asp-for="Price">
                        Proje Ücreti
                    </label>

                    <div class="price-input">

                        <input asp-for="Price"
                               class="form-control"
                               placeholder="0" />

                        <span>₺</span>

                    </div>

                    <span asp-validation-for="Price"
                          class="text-danger"></span>

                </div>


                <div class="form-group">

                    <label asp-for="PaidAmount">
                        Tahsil Edilen
                    </label>

                    <div class="price-input">

                        <input asp-for="PaidAmount"
                               class="form-control"
                               placeholder="0" />

                        <span>₺</span>

                    </div>

                    <span asp-validation-for="PaidAmount"
                          class="text-danger"></span>

                    <small class="field-hint">
                        Müşteriden şu ana kadar aldığın ödeme.
                    </small>

                </div>


                <div class="form-group">

                    <label asp-for="StartDate">
                        Başlangıç Tarihi
                    </label>

                    <input asp-for="StartDate"
                           class="form-control"
                           type="date" />

                    <span asp-validation-for="StartDate"
                          class="text-danger"></span>

                </div>


                <div class="form-group">

                    <label asp-for="Deadline">
                        Teslim Tarihi
                    </label>

                    <input asp-for="Deadline"
                           class="form-control"
                           type="date" />

                    <span asp-validation-for="Deadline"
                          class="text-danger"></span>

                </div>


                <div class="form-group full-width">

                    <label asp-for="Status">
                        Proje Durumu
                    </label>

                    <select asp-for="Status"
                            asp-items="Html.GetEnumSelectList<FreelancerWorkTracker.Models.ProjectStatus>()"
                            class="form-select">
                    </select>

                    <span asp-validation-for="Status"
                          class="text-danger"></span>

                </div>

            </div>


            <div class="form-actions">

                <a asp-action="Index"
                   class="secondary-button">
                    İptal
                </a>

                <button type="submit"
                        class="primary-button">
                    Projeyi Oluştur
                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}